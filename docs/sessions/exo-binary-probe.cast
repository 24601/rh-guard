[0.007037, "o", "-rwxr-xr-x 2 ubuntu ubuntu 599717968 Sep 18 17:34 /tmp/exo-src/target/debug/exo\r\n\r\n----- exo help (first commands) -----\r\n"]
[0.019747, "o", "CLI for exo agents\r\n\r\nUsage: exo [OPTIONS] <COMMAND>\r\n\r\nCommands:\r\n  agent         Manage agents and their executor configuration\r\n"]
[0.019774, "o", "  conversation  Manage conversations, mounts, events, and one-shot sends\r\n  model         Register and list model bindings\r\n  provider      Configure and list sandbox provider bindings\r\n  sandbox       Manage sandboxes directly. Each command accepts --agent; omitted uses a shared owner\r\n"]
[0.01992, "o", "  secret        Manage local stored secrets\r\n  repl          Start an interactive REPL, creating a default agent and conversation when needed\r\n  adapters      \r\n  tools         Inspect locally installed tool modules\r\n  serve         \r\n  help          Print this message or the help of the given subcommand(s)\r\n\r\nOptions:\r\n      --egress-policy <EGRESS_POLICY>\r\n          JSON, YAML, or TOML policy for sandbox hosts and credential substitution\r\n      --root <ROOT>\r\n          [default: .exo]\r\n      --harness <HARNESS>\r\n          Executor runtime: basic, rlm, typescript, codex, claude-code, cursor, or a TypeScript module path\r\n      --secret-backend <SECRET_BACKEND>\r\n          [env: EXO_SECRET_BACKEND=] [possible values: apple-keychain, file]\r\n      --master-key-path <MASTER_KEY_PATH>\r\n          [env: EXO_MASTER_KEY_PATH=]\r\n      --env-file <ENV_FILE>\r\n          \r\n      --env-file-if-exists <ENV_FILE_IF_EXISTS>\r\n          \r\n      --exoharness-url <EXOHARNESS_URL>\r\n          [env: EXO_EXOHARNESS_URL=] [aliases: --url]\r\n"]
[0.019936, "o", "      --bearer-env <ENV_VAR>\r\n          Environment variable whose value is sent as the HTTP bearer token [env: EXO_BEARER_ENV=]\r\n"]
[0.019956, "o", "      --pricing-path <PRICING_PATH>\r\n          Path to a LiteLLM price JSON for cost tracking (overrides fetch/cache) [env: EXO_LITELLM_PRICES_PATH=]\r\n"]
[0.019976, "o", "      --pricing-url <PRICING_URL>\r\n          URL to fetch the LiteLLM price JSON from (overrides the default source) [env: EXO_LITELLM_PRICES_URL=]\r\n"]
[0.020023, "o", "  -h, --help\r\n          Print help\r\n\r\nRuntime options:\r\n  --braintrust-api-key <BRAINTRUST_API_KEY>\r\n  --braintrust-app-url <BRAINTRUST_APP_URL>\r\n  --braintrust-api-url <BRAINTRUST_API_URL>\r\n\r\nThese options are accepted globally, including after subcommands, but are hidden from subcommand help to reduce noise.\r\n"]
